NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/expense_tracker_db

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_should_be_at_least_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_should_be_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
